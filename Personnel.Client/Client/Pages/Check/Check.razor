@page "/check"

<EditForm Model="@model">
    <DataAnnotationsValidator />
    <MudCard>
        <MudCardHeader>
            <MudText Typo="Typo.h5">Registrar Entrada</MudText>
        </MudCardHeader>
        <MudCardContent>
            <MudTextField  Label="Correo" Class="mt-3"
                          @bind-Value="model.Email" For="@(() => model.Email)" />
        </MudCardContent>
        <MudCardActions>
            <MudButton Color="Color.Primary" Variant="Variant.Filled">Enviar</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>
