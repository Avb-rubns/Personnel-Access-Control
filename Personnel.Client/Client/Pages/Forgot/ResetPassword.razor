@page "/reset-password/{Token}"
@layout CleanLayout
@if (_loader)
{
    <section class="d-none d-md-flex h-100 mt-3 w-100 reset-password-section">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="660px" Height="420px" />
    </section>
    <section class="d-md-none d-flex flex-column gap-2  align-center justify-center h-100 w-100 reset-password-section">
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" Height="32px" />
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" Height="28px" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="42px" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="24px" />
    </section>
}
else
{
    if (isValidToken)
    {
        if (!_send)
        {
            <section class="d-flex align-center flex-column mt-3 h-100 w-100 reset-password-section">
                <div class="w-100 reset-password-registration">
                    <EditForm Model="@model" OnValidSubmit="OnValidSubmit">
                        <DataAnnotationsValidator />
                        <MudText Typo="Typo.h5" Align="MudBlazor.Align.Center">@Resource.ResetPasswordtitle</MudText>
                        <MudText Typo="Typo.subtitle1" Align="MudBlazor.Align.Center">@Resource.ResetPasswordSubtitle</MudText>
                        <MudTextField Label="@Resource.NewPasswordTitle"
                                      Class="mt-3"
                                      Disabled="@_processing"
                                      @bind-Value="model.Password"
                                      DebounceInterval="5" OnDebounceIntervalElapsed="@(CheckingPassword)"
                                      For="@(() => model.Password)"
                                      Variant="Variant.Text"
                                      InputType="@PasswordInput"
                                      AdornmentIcon="@PasswordInputIcon"
                                      Adornment="Adornment.End"
                                      OnAdornmentClick="Visibility"
                                      AdornmentAriaLabel="ver" />
                        <MudTextField Label="@Resource.PasswordTitleConfirme"
                                      Class="mt-3"
                                      Disabled="@_processing"
                                      @bind-Value="model.NewPassword"
                                      Immediate="true"
                                      For="@(() => model.NewPassword)"
                                      Variant="Variant.Text"
                                      InputType="@PasswordInput"
                                      AdornmentIcon="@PasswordInputIcon"
                                      Adornment="Adornment.End"
                                      OnAdornmentClick="Visibility"
                                      AdornmentAriaLabel="ver" />

                        <MudText class="mt-3" Typo="Typo.body1">@Resource.ResetPasswordRequirements</MudText>
                        <div class="d-flex align-center">
                            <MudIcon Color="@(HasMinimumLength? MudBlazor.Color.Primary: MudBlazor.Color.Secondary)"
                                     Icon="@(HasMinimumLength ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.Circle)" />
                            <MudText Class="ml-1" Typo="Typo.body2">@Resource.ResetPasswordMinLength</MudText>
                        </div>
                        <div class="d-flex align-center">
                            <MudIcon Color="@(HasUppercaseLetter? MudBlazor.Color.Primary: MudBlazor.Color.Secondary)"
                                     Icon="@(HasUppercaseLetter ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.Circle)" />
                            <MudText Class="ml-1" Typo="Typo.body2">@Resource.ResetPasswordMay</MudText>
                        </div>
                        <div class="d-flex align-center ">
                            <MudIcon Color="@(HasLowercaseLetter? MudBlazor.Color.Primary: MudBlazor.Color.Secondary)"
                                     Icon="@(HasLowercaseLetter ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.Circle)" />
                            <MudText Class="ml-1" Typo="Typo.body2">@Resource.ResetPasswordLowercaseReq</MudText>
                        </div>
                        <div class="d-flex align-center">
                            <MudIcon Color="@(HasDigit? MudBlazor.Color.Primary: MudBlazor.Color.Secondary)"
                                     Icon="@(HasDigit ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.Circle)" />
                            <MudText Class="ml-1" Typo="Typo.body2">@Resource.ResetPasswordNumberReq</MudText>
                        </div>
                        <div class="d-flex align-center">
                            <MudIcon Color="@(HasSpecialCharacter? MudBlazor.Color.Primary: MudBlazor.Color.Secondary)"
                                     Icon="@(HasSpecialCharacter ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.Circle)" />
                            <MudText Class="ml-1" Typo="Typo.body2">@Resource.ResetPasswordMinLength</MudText>
                        </div>
                        <div class="d-flex align-center">
                            <MudIcon Color="@(HasMinimumLength? MudBlazor.Color.Primary: MudBlazor.Color.Secondary)"
                                     Icon="@(HasMinimumLength ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.Circle)" />
                            <MudText Class="ml-1" Typo="Typo.body2">@Resource.ResetPasswordSpecialCharReq</MudText>
                        </div>
                        <MudButton Disabled="@_processing" Class="mt-3" Color="MudBlazor.Color.Primary" FullWidth="true"
                                   Variant="Variant.Filled" ButtonType="ButtonType.Submit">
                            @if (_processing)
                            {
                                <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">@Resource.BtnSending</MudText>
                            }
                            else
                            {
                                <MudText>@Resource.ResetPasswordSend</MudText>
                            }
                        </MudButton>
                    </EditForm>
                </div>
                <strong>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Color="MudBlazor.Color.Primary" />
                    <MudLink Href="/" Typo="Typo.subtitle2">@Resource.ReturnLgoInTitle</MudLink>
                </strong>
            </section>
        }
        else
        {
            <section class="d-flex align-center flex-column text-center h-100 w-100 reset-password-section">
                <div class="reset-password-registration">
                    <MudCardContent>
                        <div class="d-flex flex-column align-center w-auto ">
                            <strong>
                                <MudText Typo="Typo.h4">@Resource.ResetPasswordSuccess</MudText>
                            </strong>
                            <MudText Typo="Typo.body1">@Resource.ResetPasswordSuccessMessage</MudText>
                        </div>
                    </MudCardContent>
                </div>
                <strong>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Primary" />
                    <MudLink Href="/" Typo="Typo.subtitle2">@Resource.ReturnLgoInTitle</MudLink>
                </strong>
            </section>
        }
    }
    else
    {
        <section class="d-flex align-center flex-column text-center h-100 w-100 reset-password-section-not-valid-token">
            <div class="reset-password-registration">
                <MudCardContent>
                    <div class="d-flex flex-column align-center text-center w-auto ">
                        <strong>
                            <MudText Typo="Typo.h4">@Resource.ResetTokenNotValid</MudText>
                        </strong>
                        <MudText Typo="Typo.body1">@Resource.ResetPasswordNotValidtoken</MudText>
                        <MudText Typo="Typo.body1">@Resource.ResetPassowrMessage</MudText>
                    </div>
                </MudCardContent>
            </div>

            <strong>
                <MudIcon Icon="@Icons.Material.Filled.Repeat" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Primary" />
                <MudLink Href="/forgot-password" Typo="Typo.subtitle2">@Resource.ResetPasswordRepeatToken</MudLink>
            </strong>

            <strong>
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="MudBlazor.Size.Small" Color="MudBlazor.Color.Primary" />
                <MudLink Href="/" Typo="Typo.subtitle2">@Resource.ReturnLgoInTitle</MudLink>
            </strong>
        </section>
    }


}