@page "/forgot-password"
@layout CleanLayout


<Space>
    @if (_loader)
    {
        <section class="d-none d-md-flex align-center justify-center h-100 w-100 forgot-password-section">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="320px" Height="220px" />
        </section>
        <section class="d-md-none d-flex flex-column gap-2  align-center justify-center h-100 w-100 forgot-password-section">
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" Height="32px" />
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="100%" Height="28px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="42px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="24px" />
        </section>
    }
    else
    {
        if (!_send)
        {
            <section class="d-flex align-center flex-column justify-center h-100 w-100 forgot-password-section">
                <div class="w-100 forgot-password-registration">
                    <EditForm Model="@model" OnValidSubmit="OnValidSubmit">
                        <DataAnnotationsValidator />
                        <MudText Typo="Typo.h5" Align="MudBlazor.Align.Center">@Resource.ForgotPasswordTitle</MudText>
                        <MudTextField Label="@Resource.MailText" Class="mt-3" Disabled="@_processing"
                                      @bind-Value="model.Email" For="@(() => model.Email)" Variant="Variant.Text" />
                        <MudButton Disabled="@_processing" Class="mt-3" Color="MudBlazor.Color.Primary" FullWidth="true"
                                   Variant="Variant.Filled" ButtonType="ButtonType.Submit">
                            @if (_processing)
                            {
                                <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">@Resource.BtnSending</MudText>
                            }
                            else
                            {
                                <MudText>@Resource.BtnContinum</MudText>
                            }
                        </MudButton>
                    </EditForm>
                </div>
                <strong>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Color="MudBlazor.Color.Primary" />
                    <MudLink Href="/" Typo="Typo.subtitle2">@Resource.ReturnLgoInTitle</MudLink>
                </strong>
            </section>
        }
        else
        {
            <section class="d-flex align-center flex-column text-center h-100 w-100 forgot-password-section">
                <div class="forgot-password-registration">
                    <MudCardContent>
                        <div class="d-flex flex-column align-center w-auto ">
                            <strong>
                                <MudText Typo="Typo.h4">@Resource.ForgotCheckEmail</MudText>
                            </strong>
                            <MudText Typo="Typo.body1">@Resource.ComplitSendForget</MudText>
                        </div>
                    </MudCardContent>
                </div>
                <strong>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Color="MudBlazor.Color.Primary" />
                    <MudLink Href="/" Typo="Typo.subtitle2">@Resource.ReturnLgoInTitle</MudLink>
                </strong>
            </section>
        }
    }
</Space>
