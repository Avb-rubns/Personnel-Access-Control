@page "/links"

<Space>
    <div class="p-1 mb-2 d-flex justify-content-between">
        <MudText Typo="Typo.h5">Enlaces</MudText>
        <MudButton OnClick="CreateLink" Variant="Variant.Outlined" Color="MudBlazor.Color.Primary">Crear</MudButton>
    </div>
    <MudTable ServerData="ServerReload" Dense="true" Hover="true" @ref="_table" FixedHeader="true" >
        <ToolBarContent>
            <MudSpacer/>
            <MudTextField T="string" Placeholder="Buscar" ValueChanged="@(s => OnSearch(s))" Label="Buscar" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="MudBlazor.Size.Medium" Class="mt-0" />
            
            <MudSelect Class="m-1" T="string" Label="Filtrar por Estatus" TextChanged="UpdateFilter" Value="_filter" FitContent="true" Dense="true">
                <MudSelectItem Value="@("all")">Todos</MudSelectItem>
                <MudSelectItem Value="@("true")">Activos</MudSelectItem>
                <MudSelectItem Value="@("false")">Desactivados</MudSelectItem>
            </MudSelect>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel SortLabel="name" T="LinkDTO">
                    Nombre
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortLabel="slug" T="LinkDTO">
                    URL
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortLabel="destiny" T="LinkDTO">
                    URL Destino
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortLabel="clicks" T="LinkDTO">
                    Visitas
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                QR
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortLabel="status" T="LinkDTO">
                    Estatus
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
            </MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Name</MudTd>
            <MudTd DataLabel="URL">
                <span>
                    <MudText HtmlTag="a"  style="cursor:pointer;" Typo="Typo.body2">
                         @(context.Slug)
                    </MudText>
                    <MudIconButton OnClick="@(async () => { await Utils.CopyToClipboardAsync(context.Url); })" Size="MudBlazor.Size.Small" Icon="@Icons.Material.Rounded.CopyAll" Color="MudBlazor.Color.Info" />
                </span>
            </MudTd>
            <MudTd DataLabel="URL Destino">
                <MudText HtmlTag="a" style="cursor:pointer;"  Typo="Typo.caption">@context.Content</MudText>
            </MudTd>
            <MudTd DataLabel="Visitas">
                <MudFab Size="MudBlazor.Size.Small"
                        Class="d-flex align-center justify-content-center"
                        Style="text-transform:uppercase;"
                        Label="@($"{@context.Clicks}" )"
                        DropShadow="false"
                        OnClick="@(() => Analytics(context.Slug))"
                        Color="MudBlazor.Color.Info"
                        StartIcon="@Icons.Material.Rounded.AdsClick" /> 
            </MudTd>
            <MudTd DataLabel="QR">
                <MudButton Variant="Variant.Outlined" OnClick="@(async () => { await QRShow(context); })" StartIcon="@Icons.Material.Rounded.QrCode2" IconColor="MudBlazor.Color.Error">
                    Ver
                </MudButton>
            </MudTd>
            <MudTd DataLabel="Estatus">
                @(context.Status ? "Activo":"Desactivado")
            </MudTd>
            <MudTd >
                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                         AriaLabel="Open user menu">
                    <MudMenuItem Label="Editar" Icon="@Icons.Material.Rounded.Edit" OnClick="@(() => Detail(context.Slug))" />
                </MudMenu>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Sin informacion por el momento</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>cargando...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }"
                           RowsPerPageString="Filas por pagina:"
                           InfoFormat="{first_item}-{last_item} de {all_items}"/>
        </PagerContent>
    </MudTable>
</Space>