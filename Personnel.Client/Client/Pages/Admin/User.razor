@page "/users"


<MudExpansionPanels>
    <MudExpansionPanel Expanded="true">
        <TitleContent>
            <MudText Typo="Typo.h5" Align="Align.Center">Registrar nuevo usuario</MudText>
        </TitleContent>
        <ChildContent>
            <EditForm Model="UserDTO">
            <DataAnnotationsValidator/>
            <MudGrid>
                <MudItem xs="12" sm="3">
                    <MudTextField 
                        @bind-Value="UserDTO.UserName"
                        Label="Nombre"
                        Required="true"
                        Variant="Variant.Text"
                        InputType="InputType.Text"
                        Margin="Margin.Dense"
                        For="@(() => UserDTO.UserName )" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="UserDTO.LastName"
                        Required="true"
                        Label="Apellido"
                        Variant="Variant.Text"
                        InputType="InputType.Text"
                        Margin="Margin.Dense"
                        For="@(() => UserDTO.LastName)" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="UserDTO.Email"
                        Required="true"
                        Label="Correo"
                        InputType="InputType.Email"
                        Variant="Variant.Text"
                        Margin="Margin.Dense"
                        For="@(() => UserDTO.Email)" />
                </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField @bind-Value="UserDTO.Phone"
                            Label="Teléfono"
                            Variant="Variant.Text"
                            Required = "true"
                            InputType="InputType.Telephone"
                            onKeypress=" if (!(event.charCode >= 48 && event.charCode <= 57)) event.preventDefault()"
                            Margin="Margin.Dense"
                            For="@(() => UserDTO.Phone)" />
                    </MudItem>
                <MudItem xs="12" sm="3">
                        <MudSelect T="bool"
                            Label="Estatus"
                            Required="true"
                            @bind-Value="UserDTO.Status"
                            For="@(() => UserDTO.Status)">
                            <MudSelectItem Value="false">
                                Desactivado
                            </MudSelectItem>
                            <MudSelectItem Value="true">
                                Activo
                            </MudSelectItem>
                    </MudSelect>
                        
                </MudItem>
                    <MudItem xs="12" sm="12" Class="d-flex justify-content-end g-4">
                        <MudButton Disabled="@_processing" Class="mr-3" Color="Color.Secondary"
                                   Variant="Variant.Filled">
                                <MudText>Limpiar</MudText>
                        </MudButton>
                        <MudButton Disabled="@_processing" Color="Color.Primary"
                                   Variant="Variant.Filled" ButtonType="ButtonType.Submit" >
                            @if (_processing)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Registrando</MudText>
                            }
                            else
                            {
                                <MudText>Registrar</MudText>
                            }
                        </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>