@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" MaxWidth="MaxWidth.Large" />
<MudSnackbarProvider />

<AuthorizeView>
     <Authorized>
        <MudLayout>
            <MudAppBar Elevation="1">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="DrawerToggle" />
                <MudSpacer />
                <MudMenu  Dense="true" Icon="@Icons.Material.Outlined.Settings" Color="Color.Inherit" >
                    <ActivatorContent>
                        <div class="d-flex align-center flex-column">
                            <MudAvatar Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small">@context.User.Identity?.Name[0]</MudAvatar><MudText Typo="Typo.caption">
                                @string.Join(", ", context.User.Claims
                                                            .Where(c => c.Type == ClaimTypes.Role || c.Type == "role")
                                                            .Select(c => c.Value)).ToUpper()
                            </MudText>
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem 
                            OnClick="@((e) => DarkModeAsync())"
                            Variant="Variant.Text" Color="Color.Inherit"
                            Icon="@Icons.Material.Filled.Brightness4"
                            Label="Cambiar tema"/>
                        <MudMenuItem OnClick="@Logout" Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Label="Salir" />
                    </ChildContent>
                </MudMenu>
            </MudAppBar>
            <MudDrawer @bind-Open="@_drawerOpen" Elevation="1" Breakpoint="Breakpoint.Sm" Variant="DrawerVariant.Responsive">
                <NavMenu/>
            </MudDrawer>
                <MudMainContent>
                    @Body
                </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <LogIn/>
    </NotAuthorized>
</AuthorizeView>

