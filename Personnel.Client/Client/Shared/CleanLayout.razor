@inherits LayoutComponentBase
<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" />
<MudSnackbarProvider />

<MudLayout>
    <div class="check-layout">
        <MudAppBar Elevation="1">
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Brightness4" OnClick="@((e) => DarkMode())" Color="Color.Inherit" />
        </MudAppBar>
        <MudMainContent>
            @Body
        </MudMainContent>

    </div>
</MudLayout>

@code{
    private bool _isDarkMode;
    void DarkMode()
    {
        _isDarkMode = !_isDarkMode;
    }

}