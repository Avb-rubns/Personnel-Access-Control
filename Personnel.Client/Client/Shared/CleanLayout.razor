@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" />
<MudSnackbarProvider />

<MudLayout>
    <div class="check-layout">
        <MudAppBar Elevation="1">
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Brightness4" OnClick="@((e) => DarkMode())" Color="MudBlazor.Color.Inherit" />
        </MudAppBar>
        <MudMainContent>
            @Body
        </MudMainContent>

    </div>
</MudLayout>

@code{



    private bool _isDarkMode;
    void DarkMode()
    {
        _isDarkMode = !_isDarkMode;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("getFromLocalStorage", "theme");

            if (string.IsNullOrEmpty(theme))
            {
                await JS.InvokeVoidAsync("detectColorScheme");
                theme = await JS.InvokeAsync<string>("getFromLocalStorage", "theme");
            }

            _isDarkMode = theme == "dark";

            StateHasChanged();
        }
    }
}