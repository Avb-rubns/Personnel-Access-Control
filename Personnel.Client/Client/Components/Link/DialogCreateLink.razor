<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.body2"><strong>Enlaces > Crear</strong> </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="model" OnValidSubmit="CreateAsync">
        <DataAnnotationsValidator/>
        @if (_scanURL)
        {
            <MudProgressLinear Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Large" Indeterminate="true">
                <MudText Typo="Typo.body2" Style="font-size:.8rem;">Analisando URL</MudText>
            </MudProgressLinear>
        }
        <MudTextField T="string" Required Label="URL de destino" Variant="Variant.Text" ValueChanged="GetTagUrl"
                          For="@(() => model.Content)" Disabled="_processing || _scanURL" FullWidth="true" />
        <MudTextField T="string"
                        Label="Nombre"
                        Required
                        Variant="Variant.Text"
                        FullWidth="true"
                        For="@(() => model.Name)"
                        @bind-Value="model.Name"
                        Disabled="_processing" />
        <MudPaper Elevation="0">
            <MudTextField T="string"
                          Label="Nombre descriptivo"
                          Variant="Variant.Text"
                          For="@(() => model.Slug)"
                          FullWidth="true"
                          Value="model.Slug"
                          AdornmentIcon="@Icons.Material.Outlined.Info"
                          Adornment="Adornment.End"
                          AdornmentColor="MudBlazor.Color.Warning"
                          OnAdornmentClick="ToggleOpen"
                          ValueChanged="UpdateSlug"
                          Disabled="_processing || _scanURL" >
            </MudTextField>
            <MudPopover Open="@_open"
                        Fixed="true"
                        RelativeWidth="@DropdownWidth.Relative"
                        Class="px-4 pt-4"
                        TransformOrigin="Origin.TopLeft"
                        AnchorOrigin="Origin.BottomLeft">
                <div class="d-flex flex-column">
                    <MudText>
                    Puede dejar en blanco para que se genere uno en automatico
                </MudText>
                    <MudButton OnClick="@ToggleOpen" Class="ml-auto mr-n3 mb-1" Color="MudBlazor.Color.Error">Cerrar</MudButton>
                </div>
            </MudPopover>
        </MudPaper>

        <MudSelect T="bool"
                    Label="Estatus"
                    Class="mt-1"
                    Dense="false"
                    Disabled="_processing || _scanURL"
                    Required="true"
                    @bind-Value="model.Status"
                    For="@(() => model.Status)">
            <MudSelectItem Value="true">
                Activo
            </MudSelectItem>
            <MudSelectItem Value="false">
                Desactivado
            </MudSelectItem>

        </MudSelect>
        <MudPaper Class="mt-4 d-flex justify-content-end g-5" Elevation="0">
            <MudButton Variant="Variant.Filled"
                        Color="MudBlazor.Color.Secondary"
                        Class="ms-2"
                        ButtonType="ButtonType.Reset"
                        OnClick="Cancel">
                    <MudText Class="ms-2">Cancelar</MudText>
            </MudButton>
            <MudButton Color="MudBlazor.Color.Primary"
                           Disabled="_processing || _scanURL"
                        Variant="Variant.Filled"
                        Class="ms-2 w-20"
                        ButtonType="ButtonType.Submit">
                @if (_processing)
                {
                    <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">@Resource.BtnSending</MudText>
                }
                else
                {
                    <MudText>Crear</MudText>
                }
            </MudButton>
    </MudPaper>
    </EditForm>
    </DialogContent>
</MudDialog>