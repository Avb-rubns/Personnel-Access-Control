<MudDialog ContentClass="dialog-editor-container">
    <TitleContent>
        <MudText Typo="Typo.body2">Enlaces > QR</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="12">
                <MudPaper Class="pa-2" Elevation="0">
                    <section id="qrcode" class="editor-qr-seccion-code-show" />
                    <MudPaper Elevation="0" Class="d-flex justify-center gap-3 mt-3">
                        <MudTooltip Text="Descargar">
                            <MudFab StartIcon="@Icons.Material.Filled.Download"
                                           Label="Descargar"
                                    Size="MudBlazor.Size.Small"
                                    IconSize="MudBlazor.Size.Small"
                                           OnClick="DownloadQrCode"
                                    Color="MudBlazor.Color.Primary" />
                        </MudTooltip>
                        <MudTooltip Text="@Resource.CreateQrBtnShare">
                            <MudFab StartIcon="@Icons.Material.Filled.Share"
                                           Label="Compartir"
                                    IconSize="MudBlazor.Size.Small"
                                    Size="MudBlazor.Size.Small"
                                           OnClick="ShareQrCode"
                                    Color="MudBlazor.Color.Info" />
                        </MudTooltip>

                    </MudPaper>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </DialogContent>
</MudDialog>